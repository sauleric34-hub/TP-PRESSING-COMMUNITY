		{
			"name": "Commandes",
			"item": [
				{
					"name": "Créer Commande (JSON)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"typeService\": \"EXPRESS\",\n    \"vetements\": [\n        {\n            \"nom\": \"Veste de luxe\",\n            \"categorie\": \"Haut\",\n            \"couleur\": \"Bleu\",\n            \"prixUnitaire\": 5000.0\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:9999/api/v1/utilisateurs/1/commandes",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "9999",
							"path": [
								"api",
								"v1",
								"utilisateurs",
								"1",
								"commandes"
							]
						}
					},
					"response": []
				},
				{
					"name": "Lister Commandes (Visualizer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var template = `",
									"    <style>",
									"        body { background: #121212; color: #e0e0e0; font-family: 'Outfit', sans-serif; }",
									"        .order-row { display: flex; border-bottom: 1px solid #333; padding: 10px; align-items: center; }",
									"        .id { width: 50px; color: #00d2ff; }",
									"        .client { flex: 1; font-weight: bold; }",
									"        .garments { flex: 2; display: flex; gap: 5px; }",
									"        .garment-img { width: 40px; height: 40px; border-radius: 4px; object-fit: cover; }",
									"    </style>",
									"    <h2>Tableau de Bord des Commandes (Sécurisé)</h2>",
									"    <div class='order-row' style='background: #333; font-weight: bold;'>",
									"        <div class='id'>ID</div>",
									"        <div class='client'>Service</div>",
									"        <div class='garments'>Vêtements</div>",
									"    </div>",
									"    {{#each response.content}}",
									"        <div class='order-row'>",
									"            <div class='id'>#{{id}}</div>",
									"            <div class='client'>{{typeService}}</div>",
									"            <div class='garments'>",
									"                {{#each vetements}}",
									"                    <img class='garment-img' src='{{imageUrl}}' title='{{nom}}'>",
									"                {{/each}}",
									"            </div>",
									"        </div>",
									"    {{/each}}",
									"`;",
									"pm.visualizer.set(template, {",
									"    response: pm.response.json()",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:9999/api/v1/commandes",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "9999",
							"path": [
								"api",
								"v1",
								"commandes"
							]
						}
					},
					"response": []
				}
			]
		}
