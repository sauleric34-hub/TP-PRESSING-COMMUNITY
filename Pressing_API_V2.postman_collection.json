		{
			"name": "5. Rechercher (Visualizer)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var template = `",
							"    <style>",
							"        body { background: #1a1a1a; color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }",
							"        .card { border: 1px solid #444; border-radius: 8px; padding: 15px; margin: 10px; background: #2a2a2a; box-shadow: 0 4px 8px rgba(0,0,0,0.3); }",
							"        .header { color: #00d2ff; font-weight: bold; border-bottom: 2px solid #00d2ff; padding-bottom: 5px; }",
							"        .img-container { text-align: center; margin-top: 10px; }",
							"        .img-container img { max-width: 150px; border-radius: 5px; }",
							"        .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.8em; margin-left: 5px; }",
							"        .express { background: #ff416c; }",
							"        .normal { background: #00d2ff; }",
							"    </style>",
							"    <h2>Résultats de la Recherche</h2>",
							"    {{#each response.content}}",
							"        <div class='card'>",
							"            <div class='header'>COMMANDE #{{id}} - {{typeService}}</div>",
							"            <p>Date Retrait Prévue: {{dateRetraitPrevue}}</p>",
							"            <p>Prix Total: {{prixTotal}} FCFA</p>",
							"            <div class='img-container'>",
							"                {{#each vetements}}",
							"                    <img src='{{imageUrl}}' alt='{{nom}}' title='{{nom}} ({{couleur}})'>",
							"                {{/each}}",
							"            </div>",
							"        </div>",
							"    {{/each}}",
							"`;",
							"pm.visualizer.set(template, {",
							"    response: pm.response.json()",
							"});"
						],
						"type": "text/javascript"
					}
				}
